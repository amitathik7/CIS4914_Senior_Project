  "provenance": {
    "derived_by": "by hand, from the strategy document and the fixture bars; not copied from any run of the tool",
    "sources": [
      "docs/STRATEGY_LAB.md section 12 (not_a_bar) and section 7 (types)",
      "docs/strategies/moving_average_crossover.md section 3 (input assumptions)"
    ],
    "derivation": [
      "rows: bar 10, trade, bar 11, trade, bar 10; crossover 1/2",
      "event 0: first bar, window 10 (long 2 not full): warming up; events 1 and 3 are trades: ignored, not_a_bar, no window change",
      "event 2: bar 11, window 10 11, short 11 > long 21/2: the baseline; event 4: bar 10, window 11 10, short 10 < 21/2: Sell"
