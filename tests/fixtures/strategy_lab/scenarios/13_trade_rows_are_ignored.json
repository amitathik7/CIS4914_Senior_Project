      {"strategy": "sma_1_2", "event_index": 4, "symbol": "AAPL", "side": "sell", "signal_id": 1}
    ],
    "events": [
      {"strategy": "sma_1_2", "event_index": 0, "verdict": "warming_up", "reason": "warming_up"},
      {"strategy": "sma_1_2", "event_index": 1, "type": "trade", "verdict": "ignored", "reason": "not_a_bar", "action": "none"},
      {"strategy": "sma_1_2", "event_index": 2, "verdict": "evaluated", "reason": "baseline_established", "window_fill": 2, "indicators": {"short_sma": {"exact": "11"}, "long_sma": {"exact": "21/2"}}},
