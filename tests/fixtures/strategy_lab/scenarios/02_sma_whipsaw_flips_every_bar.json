  "id": "sma_whipsaw_flips_every_bar",
  "title": "SMA crossover: a whipsaw flips on every bar, but never before bar long_window + 1",
  "purpose": "The earliest possible signal is accepted bar long_window + 1; an alternating series then changes side on every bar.",
  "covers": ["sma_signal_timing", "sma_baseline"],
  "dataset": {
    "path": "datasets/sma_oscillation.csv",
