      {"strategy": "whipsaw", "event_index": 1, "verdict": "evaluated", "reason": "baseline_established", "action": "none", "indicators": {"short_sma": {"exact": "2"}, "long_sma": {"exact": "3/2"}}},
      {"strategy": "whipsaw", "event_index": 2, "verdict": "evaluated", "reason": "crossover_sell", "action": "sell", "indicators": {"short_sma": {"exact": "1"}, "long_sma": {"exact": "3/2"}}}
